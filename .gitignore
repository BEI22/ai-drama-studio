# --- secrets / certs --------------------------------------------------------
# Verified with `git check-ignore` in both directions: no tracked source file
# matches these, so they only ever catch real credential material.
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*secret*
*credentials*

# --- hermes -----------------------------------------------------------------
.hermes/

# --- local verification scratch ---------------------------------------------
.verify_tmp/
.verify_front.html
backend/.tmp_db/
.build_backend.log
.build_frontend.log
# Commit-message scratch files (write with `git commit -F`): must never be
# committed by a `git add -A`.
.commitmsg*
