# ============================================================================
# AI Studio V1.0 -- copy to `.env` and fill in real values.
# Never commit the real .env (it is git-ignored).
# ============================================================================

# --- application ------------------------------------------------------------
APP_NAME=AI Studio
APP_VERSION=0.1.0
# local | docker | test | production
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# --- security ---------------------------------------------------------------
# REQUIRED: generate with `openssl rand -hex 32`
SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- database (PostgreSQL) --------------------------------------------------
# Local runs: use the host-published port from docker-compose.yml.
# Inside Docker Compose the host name is `postgres`.
DATABASE_URL=postgresql+psycopg://ai_studio:ai_studio@localhost:5432/ai_studio
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

POSTGRES_USER=ai_studio
POSTGRES_PASSWORD=ai_studio
POSTGRES_DB=ai_studio
POSTGRES_PORT=5432

# --- cache / queue ----------------------------------------------------------
# Host port 6380: 6379 is already taken by another local stack (wkcrm redis).
# Inside docker-compose the service is still reachable at redis:6379.
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_ALWAYS_EAGER=false

# --- storage ----------------------------------------------------------------
# local | s3 | oss
STORAGE_BACKEND=local
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/static
STORAGE_LOCAL_DIR=./storage

# --- AI providers (Phase 3+) ------------------------------------------------
# No real provider is wired up in Phase 1; keep these as `mock` for now.
LLM_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
TTS_PROVIDER=mock

# Real credentials go here once integrations land.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# IMAGE_API_KEY=
# VIDEO_API_KEY=
# TTS_API_KEY=

# --- http / cors ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
REQUEST_ID_HEADER=X-Request-ID

# --- frontend (Next.js) -----------------------------------------------------
# Browser-side base URL of the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
INTERNAL_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_REQUEST_ID_HEADER=X-Request-ID

# --- logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
